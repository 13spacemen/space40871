/atom/movable/Move()
	var/A = loc
	. = ..()
	move_speed = world.time - l_move_time
	l_move_time = world.time
	m_flag = 1
	if(A != loc && (A && A:z == z))
		last_move = get_dir(A, loc)

/obj/proc/throwing(t_dir, rs)
	if(throwspeed <= 1) throwing = 0
	throwspeed--
	if(rs == 0) rs = 1
	if(throwing)
		if(rs == 1)
			step(src, t_dir)
			sleep(1)
			spawn(0) throwing(t_dir, rs)
		else if(rs > 1)
			for(var/t, t < rs, t++)
				step(src, t_dir)
			sleep(10)
			spawn(0) throwing(t_dir, rs)
		else
			step(src, t_dir)
			sleep(10 / rs)
			spawn(0) throwing(t_dir, rs)
	else density = 0

